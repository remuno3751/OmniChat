{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniChat Server",
  "version": "1.0.1",
  "identifier": "dev.omnichat.server",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "OmniChat Server",
    "longDescription": "Runs the OmniChat server on this PC and lets you manage accounts, settings and logs.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "bundle/server/": "server/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh",
        "template": "windows/installer.nsi",
        "sidebarImage": "windows/sidebar.bmp",
        "headerImage": "windows/header.bmp",
        "installerIcon": "icons/icon.ico",
        "languages": [
          "Japanese",
          "English"
        ]
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ]
      }
    }
  }
}
