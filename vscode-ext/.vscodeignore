# Allowlist: everything is excluded unless re-included below.
**

# Extension entry point (esbuild bundle). Source maps are not shipped.
!dist/extension.js

# Webview scripts/styles, generated theme tokens, self-hosted fonts and their licenses.
!media/webview/**
!media/generated/**
!media/fonts/**
!media/icon.png
!media/omnichat-activity.svg

# Manifest and public docs.
!package.json
!package.nls*.json
!README.md
!CHANGELOG.md
!LICENSE
