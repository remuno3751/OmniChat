{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "paths": {
      "@gitops": ["../bridge/src/gitops.ts"],
      "@app/*": ["../app/src/*"]
    }
  },
  "include": ["src", "test", "scripts"]
}
