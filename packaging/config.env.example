# OmniChat server configuration (KEY=VALUE, one per line, no quotes, '#' starts a comment)
PORT=8787
HOST=0.0.0.0
# DATA_DIR / DB_PATH are set by the installer (Windows: %ProgramData%\OmniChat\data, Linux: /var/lib/omnichat)
# 1 = after an admin exists, anyone can register (as a regular user); 0 = no self-registration.
# The first administrator is always created on the server: omnichat-admin create <username>
ALLOW_REGISTRATION=0
# Optional web search backend. JSON format must be enabled in SearXNG (search.formats: [html, json])
#SEARXNG_URL=http://localhost:8888
